PORT=3000
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
DATABASE_URL="postgresql://postgres:password@localhost:5432/evergreeners"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# GitHub Organization Onboarding Automation (Hack Club Model)
# Fine-grained PAT or GitHub App token with Organization Permissions:
# - Members: Read and write
# - Organization administration: Read-only
GITHUB_ORG_ADMIN_TOKEN="ghp_your_org_admin_token_here"
GITHUB_COMMUNITY_ORG="evergreeners"
