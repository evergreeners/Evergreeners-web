{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "https://evergreeners-web-production.up.railway.app/api/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://evergreeners-web-production.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}