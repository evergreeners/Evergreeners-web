{
  "redirects": [
    {
      "source": "/api/auth/callback/github",
      "destination": "https://evergreeners-web-production.up.railway.app/api/auth/callback/github",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://evergreeners-web-production.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}